{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/threats-1.0.schema.json",
  "title": "Threats Document (v1.0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "threats"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema/document version. Must be exactly '1.0'."
    },
    "threats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "severity", "category", "description"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Use the EXACT process ID provided as input. Do not generate new IDs."
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Short human-readable threat title."
              },
              "severity": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"],
                "description": "Risk severity level."
              },
              "category": {
                "type": "string",
                "enum": [
                  "Spoofing",
                  "Tampering",
                  "Repudiation",
                  "Information Disclosure",
                  "Denial of Service",
                  "Elevation of Privilege"
                ],
                "description": "Threat category (STRIDE)."
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "Concise explanation of the issue and its security impact."
              },
              "mitigation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "how to fix or mitigate this vulnerability"
              }
            }
          }
        }
      },
      "description": "List of identified threats mapped to the provided process IDs."
    }
  }
}